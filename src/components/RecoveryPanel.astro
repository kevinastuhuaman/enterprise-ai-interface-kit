---
import { RotateCcw } from "@lucide/astro";
---

<section class="recovery-panel" data-recovery-panel aria-labelledby="recovery-title" hidden>
  <header class="panel-heading"><div><span>Pattern 06</span><h3 id="recovery-title">Scoped recovery</h3></div><RotateCcw size={18} aria-hidden="true" /></header>
  <strong data-recovery-title></strong>
  <p data-recovery-detail></p>
  <dl><div><dt>Owner</dt><dd data-recovery-owner></dd></div><div><dt>Preserved</dt><dd data-recovery-preserved></dd></div></dl>
  <span class="command-label" data-recovery-action></span>
</section>
